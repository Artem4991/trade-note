{
  "name": "trade-note",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @trade-note/web dev",
    "build": "pnpm --recursive --if-present run build",
    "lint": "pnpm --recursive --if-present run lint",
    "lint:fix": "pnpm --recursive --if-present run lint:fix",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "pnpm --recursive --if-present run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "pnpm lint:fix && pnpm format",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "verify": "node scripts/verify.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  }
}
